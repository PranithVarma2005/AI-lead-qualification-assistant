# --- n8n instance ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram Bot (create via https://t.me/BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google (Sheets + Gmail OAuth2 — set up via Google Cloud Console) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sales team notification recipient ---
SALES_TEAM_EMAIL=sales-team@yourcompany.com
